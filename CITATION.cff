    given-names: Cory
    orcid: "https://orcid.org/0000-0003-4988-4583"
    affiliation: "University of Bonn"
repository-code: "https://github.com/CWWhitney/hill_climbing_bic"
license: MIT
keywords:
  - causal diagram
  - expert elicitation
  - structure learning
  - Bayesian network
  - hill climbing
  - power analysis
  - agroforestry
